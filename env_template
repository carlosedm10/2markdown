# Written by: make fresh-setup
# OCR mode is set by: make build  (tesseract)  or  make build ollama  (host Ollama)

SKIP_EXISTING=true
CONVERT_EXISTING_MD=false
OCR_ENABLED=true
OCR_BACKEND=tesseract
FETCH_REMOTE_IMAGES=false
TESSERACT_LANG=eng+spa
CLEAN_MARKDOWN=true
EXTRACT_TABLES=true
DESCRIBE_FIGURES=true
EXTRACT_ASSETS=true
MIN_IMAGE_PX=64
OCR_HYBRID=true
OCR_CONFIDENCE_MIN=60
EMIT_CHUNKS=false
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP=100
PARALLEL_WORKERS=1
FILE_TIMEOUT_SEC=300
EXPLODE_ZIP=true
SNIFF_FILETYPE=true

PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS=50
PDF_OCR_DPI=200
# PDF_OCR_MAX_PAGES=10

LLM_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_VISION_MODEL=ollama:moondream
# LLM_OCR_MAX_DIMENSION=1568
# LLM_OCR_MAX_BYTES=1500000
# LLM_OCR_JPEG_QUALITY=85

MARKITDOWN_ENABLE_PLUGINS=false

# Apple iWork (.pages, .key, .numbers) — native parsers by default
IWORK_ENABLED=true
IWORK_BACKEND=native
# IWORK_BACKEND=kreuzberg  # requires: uv sync --extra iwork-kreuzberg
# IWORK_USE_APP_EXPORT=false  # macOS only: export via Pages/Keynote/Numbers.app
